# Copy this file to .env and fill in your own keys.
#   cp .env.example .env
# .env is gitignored and must not be committed.

# Binance spot / futures. Used by src/utils/config.py, src/user/*, src/markets/market_utils.py
# Create keys at https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Twitter / X API. Used by main.py -> src/radar/twitter.py
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Ethereum RPC. Used by src/radar/chain_warning.py
# If the URL contains "infura", the collector appends INFURA_API_KEY.
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3
INFURA_API_KEY=

# OpenAI key for src/strategy/reddit.py RedditAnalyzer(api_key=...).
# The analyzer does not read this variable itself; pass it in from your own script.
GPT_SECRET_KEY=
